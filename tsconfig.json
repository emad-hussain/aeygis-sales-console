{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@aeygis/domain": ["./packages/domain/src/index.ts"],
      "@aeygis/pricing": ["./packages/pricing/src/index.ts"],
      "@aeygis/pricing-internal": ["./packages/pricing-internal/src/index.ts"],
      // Generated by Amplify during CDK synth at .amplify/generated/env/<fn>.ts.
      // It does not exist until the first `ampx sandbox` run, so `tsc` reports
      // this import as unresolved on a fresh clone. That is expected, not a bug.
      "$amplify/*": ["./.amplify/generated/*"]
    }
  },
  "include": ["amplify/**/*.ts", "packages/**/*.ts"],
  "exclude": ["node_modules", "**/dist", ".amplify"]
}
